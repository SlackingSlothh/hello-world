<section class="mx-auto max-w-3xl" x-data="editConnectionForm()">
	<div class="mb-7"><a href="/admin/db" class="text-sm font-medium text-slate-500 hover:text-slate-900">← Back to connections</a><p class="mb-2 mt-6 text-sm font-medium text-indigo-600">Administration / Edit connection</p><h1 class="text-3xl font-semibold tracking-tight">Edit database connection</h1></div>
	<div x-show="error" x-cloak class="mb-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert" x-text="error"></div>
	<div x-show="notice" x-cloak class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status" x-text="notice"></div>
	<p x-show="loading" class="text-sm text-slate-500">Loading connection settings…</p>
	<form x-show="loaded" x-cloak @submit.prevent="submit()" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
		<div class="grid gap-5 sm:grid-cols-2">
			<label class="block text-sm font-medium text-slate-700">Connection name<input class="field mt-2" x-model="name" type="text" required maxlength="100" /></label>
			<label class="block text-sm font-medium text-slate-700">Database engine<select class="field mt-2" x-model="driver"><option value="postgres">PostgreSQL</option><option value="mysql">MySQL</option><option value="mariadb">MariaDB</option></select></label>
			<label class="block text-sm font-medium text-slate-700 sm:col-span-2">New connection string (DSN)<input class="field mt-2 font-mono text-xs" x-model="dsn" type="password" autocomplete="new-password" :required="driver !== originalDriver" /><span class="mt-2 block text-xs font-normal leading-5 text-slate-500">Leave blank to keep the saved DSN. Changing the engine requires a new DSN. A replacement connection is verified before saving.</span></label>
		</div>
		<div class="my-7 border-t border-slate-100"></div>
		<h2 class="font-semibold">Connection pool</h2>
		<div class="mt-5 grid gap-5 sm:grid-cols-2">
			<label class="block text-sm font-medium text-slate-700">Maximum open connections<input class="field mt-2" x-model.number="maxOpen" type="number" min="0" max="1000" required /></label>
			<label class="block text-sm font-medium text-slate-700">Maximum idle connections<input class="field mt-2" x-model.number="maxIdle" type="number" min="0" max="1000" required /></label>
		</div>
		<p class="mt-3 text-xs text-slate-500">Open: 0 means unlimited. Idle: 0 keeps no idle connections. Idle cannot exceed a nonzero open limit.</p>
		<div class="mt-8 flex justify-end gap-3"><a class="button-secondary" href="/admin/db">Back</a><button class="button-primary" type="submit" :disabled="submitting" x-text="submitting ? 'Saving…' : 'Save changes'"></button></div>
	</form>
</section>
