<section x-data="groupAccessManager()" class="mx-auto max-w-6xl">
	<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
		<div>
			<p class="mb-2 text-sm font-medium text-indigo-600">Administration / Permissions</p>
			<h1 class="text-3xl font-semibold tracking-tight text-slate-950">Group database access</h1>
			<p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">Grant groups read or write access to managed databases. Users receive the combined access of their groups.</p>
		</div>
		<a class="button-secondary" href="/admin/db">Manage connections</a>
	</div>

	<div class="mb-7 rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm leading-6 text-indigo-900">
		Administrator group members always have read and write access to every database. Grants do not restrict administrator access.
	</div>

	<div x-show="error" x-cloak class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert" x-text="error"></div>
	<div x-show="notice" x-cloak class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status" x-text="notice"></div>

	<form @submit.prevent="createGroup()" class="mb-7 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
		<h2 class="font-semibold text-slate-950">Add group</h2>
		<p class="mt-2 text-sm text-slate-500">Create a group before assigning members and database access.</p>
		<div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end">
			<label class="block flex-1 text-sm font-medium text-slate-700">Group name
				<input class="field mt-2" x-model="groupName" name="name" required maxlength="100" placeholder="Data analysts" />
				<span class="mt-1 block text-xs text-slate-500">Names are case-sensitive. Surrounding spaces are removed.</span>
			</label>
			<button class="button-primary" type="submit" :disabled="busy || loading">Add group</button>
		</div>
	</form>

	<div x-show="loading" class="h-36 animate-pulse rounded-2xl border border-slate-200 bg-white" aria-label="Loading group access"></div>
	<div x-show="!loading && connections.length === 0" x-cloak class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
		<h2 class="font-semibold text-slate-900">No managed databases yet</h2>
		<p class="mt-2 text-sm text-slate-500">Add a database connection before assigning group access.</p>
		<a href="/admin/db/new" class="button-primary mt-5">Add connection</a>
	</div>

	<div x-show="!loading" x-cloak>
		<form x-show="connections.length > 0 && groups.length > 0" @submit.prevent="grant()" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
			<h2 class="font-semibold text-slate-950">Add or update access</h2>
			<div class="mt-4 grid gap-4 sm:grid-cols-[1fr_1fr_180px_auto] sm:items-end">
				<label class="block text-sm font-medium text-slate-700">Group
					<select class="field mt-2" x-model="groupID" required>
						<template x-for="group in groups" :key="group.id"><option :value="group.id" x-text="group.name"></option></template>
					</select>
				</label>
				<label class="block text-sm font-medium text-slate-700">Database
					<select class="field mt-2" x-model="databaseID" required>
						<template x-for="connection in connections" :key="connection.id"><option :value="connection.id" x-text="`${connection.name} (${connection.driver})`"></option></template>
					</select>
				</label>
				<label class="block text-sm font-medium text-slate-700">Access
					<select class="field mt-2" x-model="access"><option value="read">Read only</option><option value="write">Read and write</option></select>
				</label>
				<button class="button-primary" type="submit" :disabled="busy"> <span x-text="busy ? 'Saving…' : 'Save access'"></span></button>
			</div>
		</form>

		<div class="mt-8 space-y-5">
			<template x-for="group in groups" :key="group.id">
				<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
					<header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
						<div><h2 class="font-semibold text-slate-950" x-text="group.name"></h2><p class="mt-1 text-xs text-slate-500" x-text="group.id"></p></div>
						<span x-show="group.isAdmin" class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">Admin · full access</span>
					</header>
					<div class="divide-y divide-slate-100">
						<template x-if="group.grants.length === 0"><p class="px-5 py-5 text-sm text-slate-500">No database grants. Group members cannot access managed databases.</p></template>
						<template x-for="grant in group.grants" :key="grant.databaseId">
							<div class="flex flex-col justify-between gap-3 px-5 py-4 sm:flex-row sm:items-center">
								<div><p class="font-medium text-slate-800" x-text="connectionName(grant.databaseId)"></p><p class="mt-1 text-xs text-slate-500" x-text="grant.databaseId"></p></div>
								<div class="flex items-center gap-2">
									<select class="field min-w-40" :aria-label="`Access for ${group.name}`" :value="grant.access === 'none' ? 'read' : grant.access" @change="update(group, grant, $event.target.value)"><option value="read">Read only</option><option value="write">Read and write</option></select>
									<button class="button-danger" type="button" :disabled="busy" @click="revoke(group, grant)">Revoke</button>
								</div>
							</div>
						</template>
					</div>
				</section>
			</template>
		</div>
	</div>
</section>
