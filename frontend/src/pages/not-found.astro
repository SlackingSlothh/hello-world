---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Page not found">
	<section class="mx-auto max-w-xl py-12 text-center sm:py-20">
		<p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">404</p>
		<h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Page not found</h1>
		<p class="mt-3 text-sm leading-6 text-slate-500">The page you requested does not exist.</p>
		<a class="button-primary mt-7" href="/db">Back to databases</a>
	</section>
</Layout>
