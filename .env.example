# Dev lokal
APP_PORT=8080
FRONTEND_PORT=80
FRONTEND_ORIGINS=http://localhost
PUBLIC_ORIGIN=http://localhost
ALLOW_INSECURE_LOCAL_HTTP=true
PUBLIC_API_BASE_URL=http://localhost:8080
DATABASE_STORE_DSN=postgres://hello_world:local_dev_password@db:5432/hello_world?sslmode=disable
# Generate with: openssl rand -hex 32. Keep this value stable across restarts.
DATABASE_ENCRYPTION_KEY=replace_with_at_least_32_random_bytes
# Local development key only. Use a random key in deployment and keep it stable.
# Generate with:
# openssl rand -base64 32
SESSION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-local-change-me
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=user-local-change-me
DB_PORT=5433
POSTGRES_DB=hello_world
POSTGRES_USER=hello_world
POSTGRES_PASSWORD=local_dev_password
EXAMPLE_DB_PORT=5434
EXAMPLE_POSTGRES_DB=example_db
EXAMPLE_POSTGRES_USER=example_user
EXAMPLE_POSTGRES_PASSWORD=example_local_password
